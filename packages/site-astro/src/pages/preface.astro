---
import MainLayout from '../layouts/MainLayout.astro'
import PrefaceWall from '../components/PrefaceWall.vue'
import PageHeader from '../components/PageHeader.astro'
import { normalizeLegacyFileUrls } from '../../../../workers/api/src/lib/fileUrl'
import { getSsgApiBase } from '../utils/ssgApiBase'

const API_BASE = getSsgApiBase()
const base = process.env.SITE_BASE || import.meta.env.BASE_URL || '/'
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`
const CLIENT_API_BASE = import.meta.env.VITE_API_BASE_URL || (base.endsWith('/') ? base.slice(0, -1) : base)

let config: any = {
  preface: { title: '致青春岁月', subtitle: '写在翻开同学录之前', content: '' },
  acknowledgments: [],
}
let studentCount = 0
let photoCount = 0
let timelineCount = 0

async function fetchWithRetry(url: string, retries = 4, delay = 1000): Promise<any> {
  for (let attempt = 0; attempt <= retries; attempt++) {
    try {
      const res = await fetch(url)
      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`)
      }
      return normalizeLegacyFileUrls(await res.json())
    } catch (e: any) {
      if (attempt === retries) {
        throw e
      }
      console.warn(`preface.astro fetch failed (attempt ${attempt + 1}/${retries + 1}) for ${url}: ${e.message}. Retrying in ${delay}ms...`)
      await new Promise(r => setTimeout(r, delay))
      delay *= 2
    }
  }
}

try {
  const [configData, studentsData, albumsData, timelineData] = await Promise.all([
    fetchWithRetry(`${API_BASE}/api/config`),
    fetchWithRetry(`${API_BASE}/api/students?audience=public`),
    fetchWithRetry(`${API_BASE}/api/albums`),
    fetchWithRetry(`${API_BASE}/api/timeline`),
  ])
  if (configData.success && configData.data) config = configData.data
  studentCount = Array.isArray(studentsData?.data) ? studentsData.data.length : 0
  const albums = Array.isArray(albumsData?.data) ? albumsData.data : []
  photoCount = albums.reduce((total: number, album: { photos?: unknown[] }) => total + (Array.isArray(album.photos) ? album.photos.length : 0), 0)
  timelineCount = Array.isArray(timelineData?.data) ? timelineData.data.length : 0
} catch (e: any) {
  console.error(`❌ preface.astro failed to fetch config: ${e.message}. Aborting build.`)
  throw e
}
---

<MainLayout>
  <div class="preface-page page-shell">
    <div class="container">
      <PageHeader label="OPENING HALL" title={config.preface?.title || '致青春岁月'} subtitle={config.preface?.subtitle || '写在翻开同学录之前'} />

      <section class="preface-register fade-in" aria-label="入馆登记簿">
        <p class="preface-register__label">ARCHIVE REGISTER</p>
        <dl class="preface-register__counts">
          <div><dt>在册同学</dt><dd>{studentCount}</dd></div>
          <div><dt>班级影像</dt><dd>{photoCount}</dd></div>
          <div><dt>共同篇章</dt><dd>{timelineCount}</dd></div>
        </dl>
      </section>

      <PrefaceWall client:load initialConfig={config} apiBase={CLIENT_API_BASE} />

      <div class="preface-actions fade-in">
        <a href={href('/roster')} class="btn-primary">翻开花名录</a>
        <a href={href('/class-space')} class="btn-secondary">前往班级空间</a>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .preface-register {
    width: min(720px, 100%);
    margin: 0 auto var(--space-7);
    padding: var(--space-5);
    text-align: center;
    background: var(--surface-paper);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-surface);
  }

  .preface-register__label {
    margin: 0 0 var(--space-4);
    color: var(--accent);
    font-size: var(--type-caption-uppercase);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
  }

  .preface-register__counts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .preface-register__counts > div {
    display: grid;
    gap: var(--space-1);
    padding: 0 var(--space-4);
    border-right: 1px solid var(--border-subtle);
  }

  .preface-register__counts > div:last-child { border-right: 0; }
  .preface-register__counts dt { color: var(--text-muted); font-size: var(--type-caption); }
  .preface-register__counts dd { margin: 0; color: var(--text-primary); font-family: var(--font-display); font-size: var(--type-display-sm); }

  .preface-actions {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xxl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 768px) {
    .preface-register__counts {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .preface-register__counts > div {
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: var(--space-3);
    }

    .preface-register__counts > div:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .preface-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
