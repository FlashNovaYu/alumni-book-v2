<div class="starfield" aria-hidden="true" data-starfield-root>
  <canvas data-starfield-canvas></canvas>
  <span class="starfield__mist starfield__mist--gold"></span>
  <span class="starfield__mist starfield__mist--stamp"></span>
</div>

<script>
  import { getCurrentMotionBudget, getMotionFrameInterval } from '../utils/motion'

  type Star = {
    x: number
    y: number
    radius: number
    alpha: number
    drift: number
    depth: number
    fillStyle: string
    shadowColor: string
  }

  const seed = (index: number) => ((Math.sin(index * 12.9898) * 43758.5453) % 1 + 1) % 1

  const readRgb = (styles: CSSStyleDeclaration, name: string, fallback: string) => {
    const value = styles.getPropertyValue(name).trim()
    return value || fallback
  }

  function initStarfield() {
    const root = document.querySelector<HTMLElement>('[data-starfield-root]')
    const canvas = root?.querySelector<HTMLCanvasElement>('[data-starfield-canvas]')
    if (!root || !canvas || root.dataset.starfieldReady === 'true') return

    root.dataset.starfieldReady = 'true'
    const context = canvas.getContext('2d')
    if (!context) return

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    const mobileQuery = window.matchMedia('(max-width: 768px)')
    const stars = Array.from({ length: mobileQuery.matches ? 38 : 72 }, (_, index): Star => ({
      x: seed(index + 1),
      y: seed(index + 101),
      radius: 0.45 + seed(index + 201) * 1.55,
      alpha: 0.16 + seed(index + 301) * 0.62,
      drift: 0.16 + seed(index + 401) * 0.52,
      depth: 0.24 + seed(index + 501) * 0.76,
      fillStyle: '',
      shadowColor: '',
    }))

    const motionBudget = getCurrentMotionBudget()
    const frameInterval = getMotionFrameInterval(motionBudget)
    let frame = 0
    let width = 0
    let height = 0
    let ratio = 1
    let visible = document.visibilityState === 'visible'
    let disposed = false
    let lastDrawAt = Number.NEGATIVE_INFINITY
    let offsetX = 0
    let offsetY = 0
    let coreRgb = '242 231 201'
    let haloRgb = '201 162 75'
    let alphaScale = 1

    const refreshTheme = () => {
      const styles = getComputedStyle(document.documentElement)
      offsetX = Number.parseFloat(styles.getPropertyValue('--ambient-tilt-x')) || 0
      offsetY = Number.parseFloat(styles.getPropertyValue('--ambient-tilt-y')) || 0
      coreRgb = readRgb(styles, '--star-core-rgb', coreRgb)
      haloRgb = readRgb(styles, '--star-halo-rgb', haloRgb)
      alphaScale = Number.parseFloat(styles.getPropertyValue('--star-alpha-scale')) || 1
      stars.forEach((star) => {
        star.fillStyle = `rgb(${coreRgb} / ${star.alpha * alphaScale})`
        star.shadowColor = `rgb(${haloRgb} / ${star.alpha * 0.24})`
      })
    }

    const resize = () => {
      const bounds = root.getBoundingClientRect()
      width = Math.max(1, Math.round(bounds.width))
      height = Math.max(1, Math.round(bounds.height))
      ratio = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = Math.round(width * ratio)
      canvas.height = Math.round(height * ratio)
      canvas.style.width = `${width}px`
      canvas.style.height = `${height}px`
      refreshTheme()
      draw(0, true)
    }

    const draw = (timestamp: number, force = false) => {
      if (!force && frameInterval > 0 && timestamp - lastDrawAt < frameInterval) return
      lastDrawAt = timestamp
      context.setTransform(ratio, 0, 0, ratio, 0, 0)
      context.clearRect(0, 0, width, height)
      const time = motionQuery.matches ? 0 : timestamp / 1000

      for (const star of stars) {
        const x = (star.x * width + offsetX * star.depth + time * star.drift * 8) % width
        const y = (star.y * height + offsetY * star.depth + Math.sin(time * star.drift + star.x * 16) * star.depth * 5) % height
        context.beginPath()
        context.fillStyle = star.fillStyle
        context.shadowColor = star.shadowColor
        context.shadowBlur = star.radius > 1.2 ? 3 : 0
        context.arc(x < 0 ? x + width : x, y < 0 ? y + height : y, star.radius, 0, Math.PI * 2)
        context.fill()
        context.shadowBlur = 0
      }
    }

    const canAnimate = () => visible && !motionQuery.matches && motionBudget !== 'reduced'

    const tick = (timestamp: number) => {
      draw(timestamp)
      if (canAnimate()) frame = requestAnimationFrame(tick)
    }

    const restart = () => {
      cancelAnimationFrame(frame)
      lastDrawAt = Number.NEGATIVE_INFINITY
      refreshTheme()
      draw(performance.now(), true)
      if (canAnimate()) frame = requestAnimationFrame(tick)
    }

    const onVisibilityChange = () => {
      visible = document.visibilityState === 'visible'
      if (visible) restart()
      else cancelAnimationFrame(frame)
    }

    const onAmbientTilt = (event: Event) => {
      const detail = (event as CustomEvent<{ x?: number; y?: number }>).detail
      if (typeof detail?.x === 'number') offsetX = detail.x
      if (typeof detail?.y === 'number') offsetY = detail.y
    }

    const onPageHide = () => cleanup()

    const cleanup = () => {
      if (disposed) return
      disposed = true
      cancelAnimationFrame(frame)
      observer.disconnect()
      themeObserver.disconnect()
      document.removeEventListener('visibilitychange', onVisibilityChange)
      document.removeEventListener('astro:before-swap', cleanup)
      document.removeEventListener('alumni:ambient-tilt', onAmbientTilt)
      motionQuery.removeEventListener('change', restart)
      window.removeEventListener('pagehide', onPageHide)
      root.dataset.starfieldReady = ''
    }

    const observer = new ResizeObserver(resize)
    const themeObserver = new MutationObserver(() => {
      refreshTheme()
      draw(performance.now(), true)
    })
    observer.observe(root)
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    document.addEventListener('visibilitychange', onVisibilityChange)
    document.addEventListener('alumni:ambient-tilt', onAmbientTilt)
    motionQuery.addEventListener('change', restart)
    resize()
    restart()

    document.addEventListener('astro:before-swap', cleanup, { once: true })
    window.addEventListener('pagehide', onPageHide, { once: true })
  }

  document.addEventListener('astro:page-load', initStarfield)
  initStarfield()
</script>

<style is:global>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
    background:
      radial-gradient(circle at 18% 16%, color-mix(in srgb, var(--gold) 14%, transparent), transparent 32%),
      radial-gradient(circle at 76% 68%, color-mix(in srgb, var(--accent) 11%, transparent), transparent 38%);
  }

  .starfield canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: var(--starfield-opacity);
    mix-blend-mode: var(--star-mix-mode);
  }

  .starfield__mist {
    position: absolute;
    width: 56vw;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.38;
    will-change: transform;
    animation: starfield-drift 28s ease-in-out infinite alternate;
  }

  .starfield__mist--gold {
    top: -20vw;
    left: -18vw;
    background: color-mix(in srgb, var(--gold) 24%, transparent);
  }

  .starfield__mist--stamp {
    right: -22vw;
    bottom: -28vw;
    background: color-mix(in srgb, var(--stamp) 20%, transparent);
    animation-delay: -14s;
    animation-direction: alternate-reverse;
  }

  [data-theme="paper"] .starfield {
    background:
      radial-gradient(circle at 18% 16%, color-mix(in srgb, var(--gold) 8%, transparent), transparent 32%),
      radial-gradient(circle at 76% 68%, color-mix(in srgb, var(--stamp) 7%, transparent), transparent 38%);
  }

  @keyframes starfield-drift {
    from { transform: translate3d(var(--ambient-tilt-x, 0px), var(--ambient-tilt-y, 0px), 0) scale(1); }
    to { transform: translate3d(calc(var(--ambient-tilt-x, 0px) + 8vw), calc(var(--ambient-tilt-y, 0px) + 5vh), 0) scale(1.12); }
  }

  @media (max-width: 768px) {
    .starfield__mist { width: 82vw; filter: blur(56px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .starfield__mist { animation: none; transform: none; will-change: auto; }
  }
</style>
