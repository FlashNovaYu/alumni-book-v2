---
/**
 * 存忆馆 · 闭馆之后 - 开场加载幕帘 LoadLid
 * 笔画勾勒动画、逐字浮现与空气锁屏淡出
 */
---

<div id="loadLid" class="load-lid" aria-hidden="true">
  <div class="lid-emblem">
    <svg viewBox="0 0 100 100" width="66" height="66" fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="50" cy="50" r="42" />
      <path d="M50 14 L50 86 M14 50 L86 50 M24 24 L76 76 M24 76 L76 24" />
      <circle cx="50" cy="50" r="22" />
    </svg>
  </div>
  <div class="lid-word" id="lidWord">
    <span>存</span><span>忆</span><span>馆</span>
  </div>
  <div class="lid-sub">SEALED AFTER HOURS · PRIVATE GALLERY</div>
</div>

<script>
  function playOpening() {
    const lid = document.getElementById('loadLid')
    if (!lid) return
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const isTest = typeof window !== 'undefined' && (
      navigator.userAgent.includes('Playwright') ||
      Boolean((window as any).__playwright) ||
      Boolean((window as any).__vite_plugin_react_preamble_installed__)
    )

    if (isReduced || isTest) {
      lid.remove()
      return
    }

    // 锁屏
    document.body.classList.add('locked')

    // 逐字延迟
    const wordSpans = lid.querySelectorAll<HTMLElement>('.lid-word span')
    wordSpans.forEach((span, i) => {
      span.style.animationDelay = `${700 + i * 90}ms`
    })

    requestAnimationFrame(() => {
      lid.classList.add('play')
    })

    setTimeout(() => {
      lid.classList.add('hide')
      document.body.classList.remove('locked')
      setTimeout(() => lid.remove(), 950)
    }, 2400)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', playOpening)
  } else {
    playOpening()
  }
</script>

<style>
  .load-lid {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: radial-gradient(ellipse at 50% 38%, #182219, #0B120E 68%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    pointer-events: none;
    transition: opacity 0.9s cubic-bezier(0.22, 0.8, 0.32, 1), visibility 0.9s;
  }

  .load-lid.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .lid-emblem svg {
    width: 66px;
    height: 66px;
  }

  .lid-emblem path,
  .lid-emblem circle {
    fill: none;
    stroke: var(--gold-hi, #E7CE8C);
    stroke-width: 1.1;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
  }

  .load-lid.play .lid-emblem path,
  .load-lid.play .lid-emblem circle {
    animation: ldraw 1.2s cubic-bezier(0.22, 0.8, 0.32, 1) forwards;
  }

  @keyframes ldraw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .lid-word {
    font-family: var(--font-display);
    font-size: clamp(30px, 6vw, 44px);
    letter-spacing: 0.18em;
    color: var(--gold-hi, #E7CE8C);
    display: inline-flex;
    gap: 6px;
    text-shadow: 0 0 22px rgba(231, 206, 140, 0.38);
  }

  .lid-word span {
    opacity: 0;
    transform: translateY(12px);
    display: inline-block;
    animation: lletter 0.6s cubic-bezier(0.22, 0.8, 0.32, 1) forwards;
  }

  .lid-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-3, #93A092);
    opacity: 0;
    animation: lfade 0.7s cubic-bezier(0.22, 0.8, 0.32, 1) forwards;
    animation-delay: 1800ms;
  }

  @keyframes lletter {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lfade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
